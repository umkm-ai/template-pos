// Prisma schema for the POS template.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id         String      @id @default(cuid())
  sku        String      @unique
  name       String
  priceCents Int
  stock      Int         @default(0)
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  saleItems  SaleItem[]

  @@index([categoryId])
}

model Sale {
  id          String     @id @default(cuid())
  totalCents  Int
  paidCents   Int
  changeCents Int        @default(0)
  createdAt   DateTime   @default(now())
  items       SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([saleId])
  @@index([productId])
}
